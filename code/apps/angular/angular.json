{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "diagnostics": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": ["@angular/localize/init"],
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public", "output": "/" },
              { "glob": "bootstrap.min.css", "input": "node_modules/bootstrap/dist/css", "output": "/lab-candidate-styles" },
              { "glob": "ng-zorro-antd.min.css", "input": "node_modules/ng-zorro-antd", "output": "/lab-candidate-styles" },
              { "glob": "ng-zorro-antd.dark.min.css", "input": "node_modules/ng-zorro-antd", "output": "/lab-candidate-styles" }
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist/diagnostics"
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "diagnostics:build:development"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "setupFiles": [
              "tests/setup.ts"
            ],
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    }
  }
}
