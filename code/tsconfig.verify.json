{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "incremental": false,
    "allowJs": false,
    "types": ["node"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
